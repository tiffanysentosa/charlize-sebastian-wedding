# Change this before production. Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-long-random-secret

# Optional: override demo guests with JSON (used when data/guests.json is absent).
# Easier locally: copy data/guests.example.json to data/guests.json and edit there.
# Keep this server-side; do NOT prefix with NEXT_PUBLIC_.
# GUESTS_JSON=[{"id":"guest-001","name":"Jane Smith","passcode":"paradise_in_bali","scheduleType":"extended","hotelType":"renaissance","plusOneAllowed":true},{"id":"guest-002","name":"Alex Chen","passcode":"tidal_pool","scheduleType":"extended","hotelType":"renaissance","plusOneAllowed":false},{"id":"guest-003","name":"Tiffany Sentosa","passcode":"coral_reefs_in_bali","scheduleType":"extended","hotelType":"st-regis","plusOneAllowed":true},{"id":"guest-004","name":"Maya Hartono","passcode":"sea_glass","scheduleType":"extended","hotelType":"st-regis","plusOneAllowed":false},{"id":"guest-005","name":"Sarah Lee","passcode":"sandbars_in_bali","scheduleType":"standard","hotelType":"renaissance","plusOneAllowed":true},{"id":"guest-006","name":"Daniel Okoye","passcode":"palm_shade","scheduleType":"standard","hotelType":"renaissance","plusOneAllowed":false}]

# Google Sheets (optional for local testing; required on Vercel for RSVP persistence)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=RSVPs
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n characters; the app converts them to newlines.
GOOGLE_PRIVATE_KEY=
